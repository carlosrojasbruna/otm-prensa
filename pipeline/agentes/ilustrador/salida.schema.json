{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otm-prensa.example/pipeline/agentes/ilustrador/salida.schema.json",
  "title": "salida_ilustrador",
  "description": "Salida local del ilustrador (sin contrato en contratos/). El SVG se valida además con validar_svg() en run.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tarea_id", "svg", "foto_descripcion", "paleta_usada", "viewBox", "bytes", "meta"],
  "properties": {
    "tarea_id": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[a-z0-9]+(-[a-z0-9]+)*$"},
    "svg": {"type": "string", "minLength": 50, "maxLength": 12000},
    "foto_descripcion": {"description": "Descripción textual del SVG, coherente con la imagen y sin revelar la solución.", "type": "string", "minLength": 10, "maxLength": 400},
    "paleta_usada": {"type": "array", "items": {"type": "string", "pattern": "^#[0-9a-f]{6}$"}, "uniqueItems": true},
    "viewBox": {"const": "0 0 400 300"},
    "bytes": {"type": "integer", "minimum": 1, "maximum": 12000},
    "meta": {
      "type": "object",
      "required": ["agente", "modelo", "version_prompt", "fecha", "costo_usd"],
      "properties": {
        "agente": {"const": "ilustrador"},
        "modelo": {"type": "string"},
        "version_prompt": {"type": "string"},
        "fecha": {"type": "string"},
        "costo_usd": {"type": "number", "minimum": 0},
        "intentos_reparacion": {"type": "integer", "minimum": 0}
      }
    }
  }
}
