# Variables PÚBLICAS del cliente (se incrustan en el build; no son secretos).
# Nunca pongas aquí la service_role key de Supabase.
#
# Staging/producción con Supabase:
PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica
# Opcional: enlace "Ver en repositorio" en cada tarea (sin barra final)
# PUBLIC_REPO_URL=https://github.com/USUARIO/otm-prensa
#
# Desarrollo sin servicios externos (lo fija `npm run local`):
# PUBLIC_BACKEND=local
#
# Construcción: ruta base y URL pública del hosting
# SITE_BASE=/otm-prensa/
# SITE_URL=https://USUARIO.github.io
